# ──────────────────────────────────────────────────────────────
# THE BUSINESS MULTIPLIER APP — Variables de entorno
# Copiar este archivo como .env.local y completar los valores
# ──────────────────────────────────────────────────────────────

# Supabase (obtener en: https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Solo si usás server-side operations que requieren más permisos
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# URL de la app (para emails de invitación, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
