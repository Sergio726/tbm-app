# ─────────────────────────────────────────────────────────────
# apps/admin (tbm-admin) — variables para Dokploy
# El admin lee su config (correo, IA, créditos) de la BD/Vault con el
# service-role → solo necesita las credenciales de Supabase.
# ─────────────────────────────────────────────────────────────

# ===== BUILD-TIME =====
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_anon_key

# ===== RUNTIME (secreta) =====
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
