# ─────────────────────────────────────────────────────────────
# apps/web (tbm-app) — variables para Dokploy
# Extraídas del código real (grep process.env). Ver docs/DEPLOY_DOKPLOY.md.
# ─────────────────────────────────────────────────────────────

# ===== BUILD-TIME (marcar como "Build-time / Build args" en Dokploy) =====
# Se inlinean en el bundle → tienen que estar en el BUILD, no solo en runtime.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_anon_key
NEXT_PUBLIC_APP_URL=https://app.tudominio.com   # CRÍTICO: sin esto no salen invitaciones (T2) ni links del cron
# Opcionales (analítica / errores):
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
# Solo si querés source maps de Sentry en el build:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ===== RUNTIME (secretas — NUNCA con prefijo NEXT_PUBLIC_) =====
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key      # llave maestra (bypassa RLS)
CRON_SECRET=un_string_aleatorio_largo              # protege /api/cron/daily
# Email (opcional; o se configura desde el panel admin → Correo):
RESEND_API_KEY=
RESEND_FROM=The Business Multiplier <noreply@tudominio.com>
# Asistente DC / informe DISC (opcional):
ANTHROPIC_API_KEY=
DISC_AI_MODEL=claude-haiku-4-5
DISC_AI_TEMPERATURE=0.6
DC_KILL_SWITCH=false
DC_COMPANY_MONTHLY_LIMIT=2000
# Pagos (opcional; solo si cobrás):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
